<UserControl x:Class="VjWms.Desktop.UI.Views.Pages.MasterData.WarehouseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🏢 Danh Mục Kho" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Danh sách kho (Chỉ xem - Đồng bộ từ Server)" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Tìm kiếm:" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" FontSize="13" Background="#1E293B" Foreground="White" Padding="6,4"
                     BorderThickness="1" BorderBrush="#334155" />

            <Button Content="🔄 Làm mới" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                    Padding="10,6" FontSize="12" Background="#1E293B" Foreground="#94A3B8"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="4">
            <DataGrid ItemsSource="{Binding Warehouses}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      RowBackground="#0F172A" AlternatingRowBackground="#131C2E"
                      FontSize="13" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Kho" Binding="{Binding Code}" Width="120" />
                    <DataGridTextColumn Header="Tên Kho" Binding="{Binding Name}" Width="300" />
                    <DataGridTextColumn Header="Phân loại" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn Header="Loại kho" Binding="{Binding Type}" Width="120" />
                    <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="100" />
                    <DataGridTextColumn Header="Cập nhật lần cuối" Binding="{Binding LastSyncedAt}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
