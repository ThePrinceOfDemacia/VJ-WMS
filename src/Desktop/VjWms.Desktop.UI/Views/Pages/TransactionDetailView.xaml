<UserControl x:Class="VjWms.Desktop.UI.Views.Pages.TransactionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:VjWms.Desktop.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:TransactionDetailViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{DynamicResource BgPrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Info Grid -->
            <RowDefinition Height="*" />    <!-- Items & History -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding DocumentNumber, StringFormat='Số chứng từ: {0}'}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="Đóng" Command="{Binding CloseCommand}"
                    Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="16,8" FontSize="14" Cursor="Hand" />
        </Grid>

        <!-- Info Grid -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                    <TextBlock Text="Ngày chứng từ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding DocumentDate}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,16,12">
                    <TextBlock Text="Kho" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding WarehouseName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,16,12">
                    <TextBlock Text="{Binding PartnerLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PartnerName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
                </StackPanel>
                
                <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,16,12">
                    <TextBlock Text="Trạng thái" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="Bold" />
                </StackPanel>

                <!-- Row 1 -->
                <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4">
                    <TextBlock Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap"
                               Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVisibleConverter}, FallbackValue=Collapsed}" />
                    <TextBlock Text="Không có ghi chú" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontStyle="Italic"
                               Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVisibleConverter}, ConverterParameter=Inverse}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Items & History Split -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="24" /> <!-- Spacer -->
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Line Items -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Chi tiết hàng hóa" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="12,12,12,8" />
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding LineItems}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B"
                              RowBackground="#0F172A" AlternatingRowBackground="#131C2E"
                              FontSize="13" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã hàng" Binding="{Binding ProductCode}" Width="120" />
                            <DataGridTextColumn Header="Tên hàng" Binding="{Binding ProductName}" Width="180" />
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60" />
                            <DataGridTextColumn Header="Số lô" Binding="{Binding LotNumber}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Edit History -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Lịch sử thay đổi" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding EditHistories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Timeline dot -->
                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" 
                                                Background="{DynamicResource PrimaryBrush}" 
                                                VerticalAlignment="Top" Margin="0,4,12,0" />
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding ChangedAt}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ChangedBy, StringFormat='Người thực hiện: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Notes, Converter={StaticResource NonEmptyToVisibleConverter}}" />

                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3">
                                                            <!-- A Grid "Auto" column measures its child with effectively unbounded
                                                                 width to find its natural size before TextWrapping ever gets a
                                                                 chance to kick in, so a two-column label/value split silently
                                                                 ignores TextWrapping on the label. Stacking label above value
                                                                 avoids that entirely - each line just gets the panel's real,
                                                                 already-constrained width. MaxWidth is also set directly on each
                                                                 TextBlock as a belt-and-braces guarantee against any other
                                                                 ancestor panel that hands out unbounded measure width. -->
                                                            <TextBlock Text="{Binding PropertyName, StringFormat='{}{0}:'}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="Medium"
                                                                       TextWrapping="Wrap" MaxWidth="260" />
                                                            <WrapPanel Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding OldValue}" Foreground="{DynamicResource OfflineBrush}" TextDecorations="Strikethrough"
                                                                           FontSize="12" TextWrapping="Wrap" MaxWidth="260" />
                                                                <TextBlock Text=" ➔ " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="4,0" />
                                                                <TextBlock Text="{Binding NewValue}" Foreground="{DynamicResource OnlineBrush}" FontWeight="SemiBold"
                                                                           FontSize="12" TextWrapping="Wrap" MaxWidth="260" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
