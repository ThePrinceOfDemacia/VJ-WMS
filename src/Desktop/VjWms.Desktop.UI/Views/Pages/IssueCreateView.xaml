<UserControl x:Class="VjWms.Desktop.UI.Views.Pages.IssueCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VjWms.Desktop.UI.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="📤 Tạo Phiếu Xuất Kho" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

            <!-- Error Message -->
            <Border Grid.Row="1" Background="#7F1D1D" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibleConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="13" />
            </Border>

            <!-- Form Header -->
            <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 1: Warehouse + Customer + Date -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="KHO XUẤT *" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="KHÁCH HÀNG" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="Name" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="NGÀY XUẤT" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding IssueDate}" FontSize="13" Padding="8,6" />
                    </StackPanel>

                    <!-- Row 2: Contract + RO + Reason -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="SỐ HĐ/PO" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ContractNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="SỐ LỆNH XUẤT (RO)" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RoNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="LÝ DO XUẤT" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding IssueReason, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>

                    <!-- Row 3: Delivery Term + Booking + Container -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="ĐIỀU KIỆN GIAO HÀNG" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DeliveryTerm, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="SỐ BOOKING" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BookingNo, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="SỐ CONTAINER" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ContainerNo, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>

                    <!-- Row 4: Seal + Driver -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="SỐ SEAL" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SealNo, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="TÊN LÁI XE" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DriverName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                        <TextBlock Text="CCCD LÁI XE" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DriverIdCard, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>

                    <!-- Row 5: Vehicle -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="SỐ ĐẦU XE" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding VehicleNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,12,12">
                        <TextBlock Text="SỐ MOOC" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TrailerNumber, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" />
                    </StackPanel>

                    <!-- Row 6: Notes -->
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,0">
                        <TextBlock Text="GHI CHÚ" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                                 Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Line Items Header -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="📦 Danh sách hàng hóa" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                <!-- Scanner Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button Content="📷 Quét QR từ ảnh" Command="{Binding ScanFromImageCommand}"
                            Padding="8,4" FontSize="12" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Content="📱 Máy quét USB" Command="{Binding ToggleHidScannerCommand}" Margin="8,0,0,0"
                            Padding="8,4" FontSize="12" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHidListening}" Value="True">
                                        <Setter Property="Background" Value="#3B82F6" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <TextBlock Text="{Binding ScanStatusMessage}" Foreground="#10B981" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <Button Grid.Column="2" Content="➕ Thêm dòng" Command="{Binding AddLineCommand}"
                        Padding="10,6" FontSize="12" Background="#1E293B" Foreground="#94A3B8"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Line Items -->
            <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="4">
                <DataGrid ItemsSource="{Binding LineItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          RowBackground="#0F172A" AlternatingRowBackground="#131C2E"
                          FontSize="13" HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Sản phẩm *" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableProducts}"
                                              SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="ProductName"
                                              FontSize="12" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Số lượng *" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Background="#1E293B" Foreground="White"
                                             Padding="6,4" BorderThickness="0" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitDisplay}" Width="70" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Số lô" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Background="#1E293B" Foreground="White"
                                             Padding="6,4" BorderThickness="0" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                            FontSize="14" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Attachments -->
            <controls:AttachmentPanel Grid.Row="5" DataContext="{Binding AttachmentPanel}" Margin="0,0,0,16" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="❌ Hủy" Command="{Binding CancelCommand}"
                        Padding="16,10" FontSize="13" Margin="0,0,8,0"
                        Background="#374151" Foreground="#D1D5DB" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="💾 Lưu nháp" Command="{Binding SaveDraftCommand}"
                        Padding="16,10" FontSize="13" Margin="0,0,8,0"
                        Background="#1E40AF" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="✅ Xác nhận" Command="{Binding ConfirmCommand}"
                        Padding="16,10" FontSize="13"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
