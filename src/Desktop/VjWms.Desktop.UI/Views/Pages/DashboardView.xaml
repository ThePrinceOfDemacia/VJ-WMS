<UserControl x:Class="VjWms.Desktop.UI.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VjWms.Desktop.UI.ViewModels">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="📊 Dashboard" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Tổng quan hệ thống quản lý kho" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24">
            <!-- Active Warehouses -->
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="📦 Kho hoạt động" Foreground="#64748B" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ActiveWarehouses}" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryLightBrush}" />
                </StackPanel>
            </Border>
            <!-- Draft -->
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="📝 Phiếu nháp" Foreground="#64748B" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding DraftCount}" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            <!-- Pending Sync -->
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20,16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="📥 Chờ đồng bộ" Foreground="#64748B" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PendingSyncCount}" FontSize="32" FontWeight="Bold"
                               Foreground="#F59E0B" />
                </StackPanel>
            </Border>
            <!-- Rejected -->
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="⚠️ Bị từ chối" Foreground="#64748B" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RejectedCount}" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource WarningBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Bottom section: Quick actions + Recent -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Quick Actions -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="⚡ Thao tác nhanh" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
                    <Button Content="📥  Tạo Phiếu Nhập Kho" Margin="0,0,0,8"
                            Command="{Binding NavigateToReceiptsCommand}"
                            Style="{DynamicResource QuickActionButton}" />
                    <Button Content="📤  Tạo Phiếu Xuất Kho" Margin="0,0,0,8"
                            Command="{Binding NavigateToIssuesCommand}"
                            Style="{DynamicResource QuickActionButton}" />
                    <Button Content="🔄  Tạo Phiếu Luân Chuyển" Margin="0,0,0,8"
                            Command="{Binding NavigateToTransfersCommand}"
                            Style="{DynamicResource QuickActionButton}" />
                    <Button Content="🔄  Làm mới dữ liệu"
                            Command="{Binding RefreshCommand}"
                            Style="{DynamicResource QuickActionButton}" />
                </StackPanel>
            </Border>

            <!-- Recent Activities -->
            <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🕐 Hoạt động gần đây" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6"
                                        Background="#0F172A">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2"
                                                Background="#1E293B">
                                            <TextBlock Text="{Binding Status}" FontSize="10"
                                                       Foreground="#94A3B8" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="1" Text="Chưa có hoạt động nào" FontSize="13"
                               Foreground="#475569" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding RecentActivities.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
