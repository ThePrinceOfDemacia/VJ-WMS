<UserControl x:Class="VjWms.Desktop.UI.Views.Pages.IssueListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="📤 Phiếu Xuất Kho" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Quản lý phiếu xuất kho offline" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="➕  Tạo phiếu mới" Command="{Binding CreateNewCommand}"
                    Padding="16,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Filter Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Lọc:" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag"
                      Width="160" FontSize="13" Background="#1E293B" Foreground="White">
                <ComboBoxItem Content="Tất cả" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="Nháp" Tag="Draft" />
                <ComboBoxItem Content="Chờ đồng bộ" Tag="PendingSync" />
                <ComboBoxItem Content="Bị từ chối" Tag="Rejected" />
            </ComboBox>
            <Button Content="🔄 Làm mới" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                    Padding="10,6" FontSize="12" Background="#1E293B" Foreground="#94A3B8"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="4">
            <DataGrid ItemsSource="{Binding Issues}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      RowBackground="#0F172A" AlternatingRowBackground="#131C2E"
                      FontSize="13" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Số phiếu" Binding="{Binding LocalNumber}" Width="180" />
                    <DataGridTextColumn Header="Kho" Binding="{Binding WarehouseName}" Width="200" />
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="200" />
                    <DataGridTextColumn Header="Ngày xuất" Binding="{Binding IssueDate}" Width="110" />
                    <DataGridTextColumn Header="Dòng" Binding="{Binding ItemCount}" Width="60" />
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Đồng bộ" Binding="{Binding SyncStatus}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                        FontSize="14" Cursor="Hand" Padding="4,2"
                                        Visibility="{Binding IsReadOnly, Converter={StaticResource InverseBoolToVisConverter}, FallbackValue=Visible}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Empty state -->
        <TextBlock Grid.Row="2" Text="Chưa có phiếu xuất kho nào. Nhấn 'Tạo phiếu mới' để bắt đầu!"
                   FontSize="14" Foreground="#475569"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Issues.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}" />
    </Grid>
</UserControl>
