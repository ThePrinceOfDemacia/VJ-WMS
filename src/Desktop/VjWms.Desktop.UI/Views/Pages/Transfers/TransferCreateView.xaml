<UserControl x:Class="VjWms.Desktop.UI.Views.Pages.Transfers.TransferCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VjWms.Desktop.UI.Views.Controls">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔄 Tạo Phiếu Luân Chuyển Kho" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Luân chuyển hàng hóa giữa các kho nội bộ" FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Form Header -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Kho nguồn, Kho đích, Loại -->
                <StackPanel Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Kho nguồn *" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedSourceWarehouse}"
                              DisplayMemberPath="Name" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Kho đích *" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedDestWarehouse}"
                              DisplayMemberPath="Name" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Loại luân chuyển" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TransferTypes}" SelectedItem="{Binding TransferType}"
                              FontSize="13"
                              IsEnabled="{Binding IsTransferTypeLocked, Converter={StaticResource InverseBoolConverter}}" />
                    <TextBlock Text="(Tự động: Kho vật lý bắt buộc luân chuyển vật lý)"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"
                               Visibility="{Binding IsTransferTypeLocked, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>

                <!-- Row 1: Ngày, Ghi chú -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Ngày chuyển" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,4" />
                    <DatePicker SelectedDate="{Binding TransferDate}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Text="Ghi chú" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Background="#1E293B" Foreground="White"
                             Padding="8,6" BorderThickness="1" BorderBrush="#334155" />
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                           Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="13" Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NonEmptyToVisibleConverter}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>

        <!-- Line Items -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" CornerRadius="12"
                Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="📦 Danh sách hàng hóa" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <!-- Scanner Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Button Content="📷 Quét QR từ ảnh" Command="{Binding ScanFromImageCommand}"
                                Padding="8,4" FontSize="12" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button Content="📱 Máy quét USB" Command="{Binding ToggleHidScannerCommand}" Margin="8,0,0,0"
                                Padding="8,4" FontSize="12" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHidListening}" Value="True">
                                            <Setter Property="Background" Value="#3B82F6" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <TextBlock Text="{Binding ScanStatusMessage}" Foreground="#10B981" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="➕ Thêm dòng" Command="{Binding AddLineCommand}"
                            Padding="10,6" FontSize="12" Background="#1E293B" Foreground="#94A3B8"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding LineItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          RowBackground="#0F172A" AlternatingRowBackground="#131C2E"
                          FontSize="13" HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1E293B" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Sản phẩm *" Width="250">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProducts}"
                                              SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="ProductName"
                                              FontSize="12" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Số lượng *" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Background="#1E293B" Foreground="White"
                                             Padding="6,4" BorderThickness="0" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ĐVT" Binding="{Binding UnitDisplay}" Width="70" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Số lô" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Background="#1E293B" Foreground="White"
                                             Padding="6,4" BorderThickness="0" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                            FontSize="14" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Attachments -->
        <controls:AttachmentPanel Grid.Row="3" DataContext="{Binding AttachmentPanel}" Margin="0,0,0,16" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button Content="❌ Hủy" Command="{Binding CancelCommand}"
                    Padding="16,10" FontSize="13" Background="#334155" Foreground="#94A3B8"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="💾 Lưu nháp" Command="{Binding SaveDraftCommand}"
                    Padding="16,10" FontSize="13" Background="#1E293B" Foreground="White"
                    BorderThickness="1" BorderBrush="#3B82F6" Cursor="Hand" Margin="0,0,8,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="✅ Xác nhận" Command="{Binding ConfirmCommand}"
                    Padding="16,10" FontSize="13" FontWeight="SemiBold"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
