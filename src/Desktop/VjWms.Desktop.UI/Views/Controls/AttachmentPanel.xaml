<UserControl x:Class="VjWms.Desktop.UI.Views.Controls.AttachmentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📎 Tệp đính kèm" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                
                <Button Content="➕ Thêm tệp" Command="{Binding AddFileCommand}"
                        HorizontalAlignment="Right"
                        Padding="10,6" FontSize="12" Background="#1E293B" Foreground="#94A3B8"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Attachments}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True"
                      Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E293B"
                      RowBackground="#0F172A" AlternatingRowBackground="#131C2E"
                      FontSize="13" HeadersVisibility="Column"
                      MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="30" />
                    <DataGridTextColumn Header="Tên tệp" Binding="{Binding FileName}" Width="*" />
                    <DataGridTextColumn Header="Kích thước" Binding="{Binding FileSize}" Width="100" />
                    
                    <DataGridTemplateColumn Header="" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Mở" 
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#3B82F6" BorderThickness="0"
                                            FontSize="12" Cursor="Hand" Margin="0,0,8,0" />
                                            
                                    <Button Content="✕" 
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#EF4444" BorderThickness="0"
                                            FontSize="14" Cursor="Hand"
                                            Visibility="{Binding IsVerified, Converter={StaticResource InverseBoolToVisConverter}, FallbackValue=Visible}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
