<Window x:Class="VjWms.Desktop.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LoginTitle}"
        Icon="/Assets/vjchem.ico"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- === LEFT PANEL: Branding === -->
        <Border Grid.Column="0" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E3A5F" Offset="0" />
                    <GradientStop Color="#0F172A" Offset="0.5" />
                    <GradientStop Color="#1E293B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo area -->
                <StackPanel Grid.Row="0">
                    <Image Source="/Assets/logo_transparent.png" Width="220" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,10" />
                    <TextBlock Text="WAREHOUSE MANAGEMENT SYSTEM"
                               FontSize="17" FontWeight="Bold" Foreground="#CBD5E1" Margin="10,0,0,20"
                               FontFamily="Segoe UI" />
                </StackPanel>

                <!-- Features -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,30">
                    <!-- Feature 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="#1E3A5F" Margin="0,0,14,0">
                            <TextBlock Text="📦" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Feature1Title}" Foreground="White"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Feature1Desc}"
                                       Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Feature 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="#1E3A5F" Margin="0,0,14,0">
                            <TextBlock Text="🔄" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Feature2Title}" Foreground="White"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Feature2Desc}"
                                       Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Feature 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="#1E3A5F" Margin="0,0,14,0">
                            <TextBlock Text="✍️" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Feature3Title}" Foreground="White"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Feature3Desc}"
                                       Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Grid.Row="2" Foreground="#475569" FontSize="11"
                           Text="CÔNG TY CỔ PHẦN TẬP ĐOÀN VJCHEM — v0.1.0-alpha" />
            </Grid>
        </Border>

        <!-- === RIGHT PANEL: Login Form === -->
        <Border Grid.Column="1" Background="{StaticResource BgSecondaryBrush}">
            <Grid Margin="40" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Title -->
                    <TextBlock Text="{DynamicResource LoginHeader}" Style="{StaticResource TitleText}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource LoginSubheader}"
                               Style="{StaticResource SubtitleText}" Margin="0,0,0,36" />

                    <!-- Server Status -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="14,10"
                            Margin="0,0,0,28">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10"
                                     Fill="{StaticResource OfflineBrush}" Margin="0,0,10,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="{DynamicResource CheckingConnection}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Username -->
                    <TextBlock Text="{DynamicResource UsernameLabel}" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,20"
                             KeyDown="OnUsernameKeyDown" />

                    <!-- Password -->
                    <TextBlock Text="{DynamicResource PasswordLabel}" Style="{StaticResource LabelText}" />
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,12"
                                 PasswordChanged="OnPasswordChanged"
                                 KeyDown="OnPasswordKeyDown" />

                    <!-- Error message -->
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" Margin="0,0,0,20"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <!-- Login Button -->
                    <Button x:Name="LoginButton" Content="{DynamicResource LoginBtn}"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0" />

                    <!-- Language switcher -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                        <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="LangViBtn" Text="Tiếng Việt"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,8,0" Cursor="Hand"
                                   MouseLeftButtonDown="OnVietnameseClick"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="|" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="LangEnBtn" Text="English"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Cursor="Hand"
                                   MouseLeftButtonDown="OnEnglishClick"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
