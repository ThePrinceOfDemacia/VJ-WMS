<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Login Window -->
    <system:String x:Key="LoginTitle">VJ-WMS — Login</system:String>
    <system:String x:Key="Feature1Title">Offline-First Warehouse Management</system:String>
    <system:String x:Key="Feature1Desc">Works continuously even without internet connection</system:String>
    <system:String x:Key="Feature2Title">Automatic Synchronization</system:String>
    <system:String x:Key="Feature2Desc">Syncs automatically when connection is restored</system:String>
    <system:String x:Key="Feature3Title">Digital Signature</system:String>
    <system:String x:Key="Feature3Desc">USB Token (Viettel-CA / FPT-CA)</system:String>
    <system:String x:Key="LoginHeader">Login</system:String>
    <system:String x:Key="LoginSubheader">Enter your credentials to continue (Auto-Update successful!)</system:String>
    <system:String x:Key="CheckingConnection">Checking connection...</system:String>
    <system:String x:Key="UsernameLabel">USERNAME</system:String>
    <system:String x:Key="PasswordLabel">PASSWORD</system:String>
    <system:String x:Key="LoginBtn">Login</system:String>
    <system:String x:Key="LoginBtnLoading">Logging in...</system:String>
    <system:String x:Key="EnterCredentialsMsg">Please enter username and password</system:String>
    <system:String x:Key="WrongCredentialsMsg">Incorrect username or password</system:String>
    <system:String x:Key="LoginErrorMsg">Login error: {0}</system:String>
    <system:String x:Key="ServerConnected">Connected to server</system:String>
    <system:String x:Key="ServerOffline">Offline — Login with saved credentials</system:String>

    <!-- Shell Window -->
    <system:String x:Key="ShellTitle">VJ-WMS — Warehouse Management</system:String>
    <system:String x:Key="NavOverview">OVERVIEW</system:String>
    <system:String x:Key="NavWarehouseOps">WAREHOUSE OPERATIONS</system:String>
    <system:String x:Key="NavTools">TOOLS</system:String>
    <system:String x:Key="NavSystem">SYSTEM</system:String>
    <system:String x:Key="MenuDashboard">📊  Dashboard</system:String>
    <system:String x:Key="MenuReceipt">📥  Goods Receipt</system:String>
    <system:String x:Key="MenuIssue">📤  Goods Issue</system:String>
    <system:String x:Key="MenuTransfer">🔄  Warehouse Transfer</system:String>
    <system:String x:Key="MenuInventory">📋  Inventory</system:String>
    <system:String x:Key="MenuScanner">📷  Scan QR/Barcode</system:String>
    <system:String x:Key="MenuAttachments">📎  Attachments</system:String>
    <system:String x:Key="MenuSearch">🔍  PDF Search</system:String>
    <system:String x:Key="MenuSync">🔄  Synchronization</system:String>
    <system:String x:Key="LogoutBtn">🚪 Logout</system:String>

    <!-- Dashboard -->
    <system:String x:Key="WelcomeMsg">Welcome to VJ-WMS</system:String>
    <system:String x:Key="WelcomeSubMsg">Offline-First Warehouse Management System</system:String>
    <system:String x:Key="StatActiveWH">📦 Active Warehouses</system:String>
    <system:String x:Key="StatPendingSync">📥 Pending Sync</system:String>
    <system:String x:Key="StatRejected">⚠️ Rejected</system:String>
    <system:String x:Key="StatusBarOnline">Online — Server connected</system:String>
    <system:String x:Key="StatusBarOffline">Offline — Local data</system:String>
    
    <system:String x:Key="LangIndicator">🌐 EN</system:String>
</ResourceDictionary>
