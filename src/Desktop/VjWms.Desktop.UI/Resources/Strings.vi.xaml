    <system:String x:Key="EnterCredentialsMsg">Vui lòng nhập tài khoản và mật khẩu</system:String>
    <system:String x:Key="WrongCredentialsMsg">Tài khoản hoặc mật khẩu không đúng</system:String>
    <system:String x:Key="LoginErrorMsg">Lỗi đăng nhập: {0}</system:String>
    <system:String x:Key="ServerConnected">Đã kết nối server</system:String>
    <system:String x:Key="ServerOffline">Offline — Đăng nhập bằng thông tin đã lưu</system:String>

    <!-- Shell Window -->
    <system:String x:Key="ShellTitle">VJ-WMS — Quản lý Kho</system:String>
    <system:String x:Key="NavOverview">TỔNG QUAN</system:String>
    <system:String x:Key="NavWarehouseOps">NGHIỆP VỤ KHO</system:String>
