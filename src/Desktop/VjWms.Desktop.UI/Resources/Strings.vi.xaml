<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Login Window -->
    <system:String x:Key="LoginTitle">VJ-WMS — Đăng nhập</system:String>
    <system:String x:Key="Feature1Title">Quản lý kho Offline-First</system:String>
    <system:String x:Key="Feature1Desc">Hoạt động liên tục ngay cả khi mất mạng</system:String>
    <system:String x:Key="Feature2Title">Đồng bộ tự động</system:String>
    <system:String x:Key="Feature2Desc">Tự động đồng bộ khi có kết nối</system:String>
    <system:String x:Key="Feature3Title">Ký số điện tử</system:String>
    <system:String x:Key="Feature3Desc">USB Token (Viettel-CA / FPT-CA)</system:String>
    <system:String x:Key="LoginHeader">Đăng nhập</system:String>
    <system:String x:Key="LoginSubheader">Nhập thông tin đăng nhập để tiếp tục</system:String>
    <system:String x:Key="CheckingConnection">Đang kiểm tra kết nối...</system:String>
    <system:String x:Key="UsernameLabel">TÀI KHOẢN</system:String>
    <system:String x:Key="PasswordLabel">MẬT KHẨU</system:String>
    <system:String x:Key="LoginBtn">Đăng nhập</system:String>
