    <system:String x:Key="WelcomeMsg">Chào mừng đến với VJ-WMS v1.0.1</system:String>
    <system:String x:Key="WelcomeSubMsg">Hệ thống Quản lý Kho Offline-First</system:String>
    <system:String x:Key="StatActiveWH">📦 Kho hoạt động</system:String>
    <system:String x:Key="StatPendingSync">📥 Chờ đồng bộ</system:String>
    <system:String x:Key="StatRejected">⚠️ Bị từ chối</system:String>
    <system:String x:Key="StatusBarOnline">Online — Kết nối server</system:String>
    <system:String x:Key="StatusBarOffline">Offline — Dữ liệu cục bộ</system:String>
    
    <system:String x:Key="LangIndicator">🌐 VI</system:String>
