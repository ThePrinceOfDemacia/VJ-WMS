    <system:String x:Key="NavSystem">HỆ THỐNG</system:String>
    <system:String x:Key="MenuDashboard">📊  Dashboard</system:String>
    <system:String x:Key="MenuReceipt">📥  Phiếu nhập kho</system:String>
    <system:String x:Key="MenuIssue">📤  Phiếu xuất kho</system:String>
    <system:String x:Key="MenuTransfer">🔄  Luân chuyển kho</system:String>
    <system:String x:Key="MenuInventory">📋  Tồn kho</system:String>
    <system:String x:Key="MenuScanner">📷  Quét QR/Barcode</system:String>
    <system:String x:Key="MenuAttachments">📎  Đính kèm</system:String>
    <system:String x:Key="MenuSearch">🔍  Tìm kiếm PDF</system:String>
    <system:String x:Key="MenuSync">🔄  Đồng bộ</system:String>
    <system:String x:Key="LogoutBtn">🚪 Đăng xuất</system:String>

